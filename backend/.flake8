[flake8]
max-line-length = 120
ignore = W291,W293,W292,E402,D100,D101,D102,D103,D104,D105,D106,D107,D200,D201,D202,D203,D204,D205,D206,D207,D208,D209,D210,D211,D212,D213,D214,D215,D300,D301,D302,D303,D304,D305,D306,D400,D401,D402,D403,D404,D405,D406,D407,D408,D409,D410,D411,D412,D413,D414,D415,D416,D417,B008
exclude = .git,.venv,__pycache__,build,dist,models,data,logs,htmlcov,.pytest_cache,scripts,tests,docker
per-file-ignores = app/main.py: E402, app/rag/api.py: E402
max-complexity = 15
