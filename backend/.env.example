# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Customer Support AI
VERSION=1.0.0
DEBUG=False

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://*.vercel.app"]

# Models
MODELS_DIR=./models
DATA_DIR=./data

# RAG
FAQ_INDEX_PATH=./models/faq_index.faiss
FAQ_METADATA_PATH=./data/faq_metadata.pkl
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Logging
LOG_LEVEL=INFO

# Monitoring
PROMETHEUS_ENABLED=True

# Database (Optional - for future)
# DATABASE_URL=postgresql://user:password@localhost:5432/customer_support