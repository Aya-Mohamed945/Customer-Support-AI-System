# backend/docker/Dockerfile.backend
# ============================================================
# Customer Support AI - Backend API
# ============================================================

FROM python:3.11-slim-trixie

WORKDIR /app

# ============================================================
# SYSTEM SECURITY UPDATES
# ============================================================
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get purge -y \
        python3-msgpack \
        python3-setuptools \
        2>/dev/null || true && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# ============================================================
# PYTHON DEPENDENCIES
# ============================================================
COPY requirements.txt .

RUN pip install \
    --no-cache-dir \
    --timeout 600 \
    --retries 20 \
    -r requirements.txt

# ============================================================
# SECURITY TOOLCHAIN
# Exact versions are intentional.
# ============================================================
RUN pip install \
    --no-cache-dir \
    --upgrade \
    "pip>=26.2.0" \
    "setuptools==83.0.0" \
    "wheel>=0.46.2" \
    "jaraco.context>=6.1.0"

# ============================================================
# SECURITY DEPENDENCY VERIFICATION
# ============================================================
RUN python -c "exec('import importlib.metadata as m\nexpected={\"msgpack\":\"1.2.1\",\"setuptools\":\"83.0.0\"}\nprint(\"=== SECURITY DEPENDENCY VERIFICATION ===\")\nfor pkg, expected_version in expected.items():\n    actual=m.version(pkg)\n    print(f\"{pkg}=={actual}\")\n    if actual != expected_version:\n        raise SystemExit(f\"ERROR: {pkg}=={actual}; expected {expected_version}\")\nprint(\"=== SECURITY DEPENDENCIES VERIFIED ===\")')"

# ============================================================
# COPY APPLICATION
# ============================================================
COPY . .

# ============================================================
# APPLICATION DIRECTORIES
# ============================================================
RUN mkdir -p models data/processed logs

# ============================================================
# NON-ROOT USER
# ============================================================
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app

USER appuser

# ============================================================
# ENVIRONMENT
# ============================================================
ENV PYTHONUNBUFFERED=1
ENV LOG_LEVEL=INFO
ENV RAG_URL=http://rag:8001

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
