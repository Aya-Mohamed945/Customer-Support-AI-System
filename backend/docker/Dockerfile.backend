# backend/docker/Dockerfile.backend
# ============================================================
# Base Image - Python 3.11 slim with security updates
# ============================================================
FROM python:3.11-slim-bookworm

# ============================================================
# System Dependencies (minimal, only what's needed)
# ============================================================
RUN apt-get update -o Acquire::Check-Valid-Until=false && \
    apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# Application Setup
# ============================================================
WORKDIR /app

# Copy requirements first (for better caching)
COPY requirements.txt .
COPY requirements-dev.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --timeout 600 --retries 20 -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p models data/processed logs

# ============================================================
# Non-root User (Security Best Practice)
# ============================================================
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# ============================================================
# Environment & Runtime
# ============================================================
ENV PYTHONUNBUFFERED=1
ENV LOG_LEVEL=INFO
ENV RAG_URL=http://rag:8001

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
