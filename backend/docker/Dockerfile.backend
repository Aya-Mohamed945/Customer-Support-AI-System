# backend/docker/Dockerfile.backend
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies with retry
RUN apt-get update -o Acquire::Check-Valid-Until=false && \
    apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
COPY requirements-dev.txt .

# ✅ Install with extended timeout and retries
RUN pip install --no-cache-dir --timeout 600 --retries 20 -r requirements.txt

# Copy application code
COPY . .

# Create directories
RUN mkdir -p models data/processed logs

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV LOG_LEVEL=INFO
ENV RAG_URL=http://rag:8001

# Expose ports
EXPOSE 8000

# Run the application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
