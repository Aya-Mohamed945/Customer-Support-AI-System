# backend/docker/Dockerfile.backend
# ============================================================
# Backend API Production Image
# ============================================================

FROM python:3.11-slim-trixie

WORKDIR /app

# ============================================================
# Dependency Installation
# ============================================================

COPY requirements.txt .
COPY requirements-dev.txt .

RUN pip install \
    --no-cache-dir \
    --timeout 600 \
    --retries 20 \
    -r requirements.txt

# ============================================================
# Security Updates
# ============================================================
# Upgrade Python packaging tools to versions that contain
# fixes for vulnerabilities reported by Trivy.

RUN pip install \
    --no-cache-dir \
    --upgrade \
    "pip>=26.2.0" \
    "setuptools>=83.0.0" \
    "wheel>=0.46.2" \
    "jaraco.context>=6.1.0"

# ============================================================
# Application
# ============================================================

COPY . .

RUN mkdir -p models data/processed logs

# ============================================================
# Non-root User
# ============================================================

RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app

USER appuser

# ============================================================
# Environment
# ============================================================

ENV PYTHONUNBUFFERED=1
ENV LOG_LEVEL=INFO
ENV RAG_URL=http://rag:8001

# ============================================================
# Port
# ============================================================

EXPOSE 8000

# ============================================================
# Start API
# ============================================================

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

