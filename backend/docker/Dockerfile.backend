# backend/docker/Dockerfile.backend
# ============================================================
# Backend API Production Image
# ============================================================

FROM python:3.11-slim-trixie

WORKDIR /app

# ============================================================
# Dependency Installation
# ============================================================

COPY requirements.txt .

# Install application dependencies first.
RUN python -m pip install \
    --no-cache-dir \
    --timeout 600 \
    --retries 20 \
    -r requirements.txt

# ============================================================
# Security Updates
# ============================================================
# Upgrade Python packaging tools to versions containing
# fixes for vulnerabilities reported by Trivy.
#
# Explicit versions are used to make the final image
# deterministic and independently verifiable.

RUN python -m pip install \
    --no-cache-dir \
    --upgrade \
    "pip>=26.2.0" \
    "setuptools>=83.0.0" \
    "wheel>=0.46.2" \
    "jaraco.context>=6.1.0"

# ============================================================
# Build-Time Security Verification
# ============================================================
# Fail the Docker build if the vulnerable versions somehow
# remain inside the image.

RUN python -c "\
import importlib.metadata as m; \
required = { \
    'msgpack': '1.2.1', \
    'setuptools': '83.0.0' \
}; \
print('=== SECURITY DEPENDENCY VERIFICATION ==='); \
[(print(f'{pkg}=={m.version(pkg)}'), \
  (_ for _ in ()).throw(SystemExit(f'ERROR: {pkg} has version {m.version(pkg)}, expected {ver}'))) \
 for pkg, ver in required.items() if m.version(pkg) != ver]; \
print('=== SECURITY DEPENDENCIES VERIFIED ===')"

# ============================================================
# Application
# ============================================================

COPY . .

RUN mkdir -p models data/processed logs

# ============================================================
# Non-root User
# ============================================================

RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app

USER appuser

# ============================================================
# Environment
# ============================================================

ENV PYTHONUNBUFFERED=1
ENV LOG_LEVEL=INFO
ENV RAG_URL=http://rag:8001

# ============================================================
# Port
# ============================================================

EXPOSE 8000

# ============================================================
# Start API
# ============================================================

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
