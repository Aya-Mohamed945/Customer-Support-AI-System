# backend/docker/Dockerfile.backend
# ============================================================
# Customer Support AI - Backend API
# ============================================================

FROM python:3.11-slim-bookworm

WORKDIR /app

# ============================================================
# System Updates
# ============================================================
RUN apt-get update && \
    apt-get upgrade -y && \
    rm -rf /var/lib/apt/lists/*

# ============================================================
# Python Dependencies
# ============================================================
COPY requirements.txt .

RUN pip install --no-cache-dir \
    --timeout 600 \
    --retries 20 \
    -r requirements.txt

# ============================================================
# Security-Sensitive Dependency Pins
# Keep these exact versions aligned with requirements.txt.
# ============================================================
RUN pip install --no-cache-dir \
    "pip>=26.2.0" \
    "setuptools==83.0.0" \
    "wheel>=0.46.2" \
    "jaraco.context>=6.1.0"

# ============================================================
# Verify Security-Sensitive Package Versions
# ============================================================
RUN python -c "\
import importlib.metadata as metadata; \
assert metadata.version('msgpack') == '1.2.1', \
'Unexpected msgpack version: ' + metadata.version('msgpack'); \
assert metadata.version('setuptools') == '83.0.0', \
'Unexpected setuptools version: ' + metadata.version('setuptools'); \
print('msgpack=' + metadata.version('msgpack')); \
print('setuptools=' + metadata.version('setuptools')); \
print('Security-sensitive dependency versions verified.')"

# ============================================================
# Application Files
# ============================================================
COPY . .

# ============================================================
# Required Directories
# ============================================================
RUN mkdir -p models data/processed logs

# ============================================================
# Non-Root User
# ============================================================
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app

USER appuser

# ============================================================
# Runtime Environment
# ============================================================
ENV PYTHONUNBUFFERED=1
ENV LOG_LEVEL=INFO
ENV RAG_URL=http://rag:8001

# ============================================================
# Service
# ============================================================
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
