# ============================================================
# Builder Stage
# ============================================================
FROM node:24.20.0-alpine3.24 AS builder

WORKDIR /app

# Copy package files first for better Docker layer caching
COPY package*.json ./

# Copy Next.js configuration files
COPY next.config.mjs ./
COPY postcss.config.mjs ./
COPY tailwind.config.ts ./
COPY tsconfig.json ./

# Install dependencies, including dev dependencies required for build
RUN npm ci

# Copy application source
COPY . .

# Build Next.js application
RUN npm run build


# ============================================================
# Runtime Stage
# ============================================================
FROM node:24.20.0-alpine3.24 AS runner

# ============================================================
# Non-root User
# ============================================================
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

WORKDIR /app

ENV NODE_ENV=production

# ============================================================
# Standalone Next.js Runtime
# ============================================================
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
