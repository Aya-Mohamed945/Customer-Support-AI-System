#Dockerfile.frontend
# ============================================================
# Builder Stage
# ============================================================
FROM node:24-alpine AS builder

WORKDIR /app

# ------------------------------------------------------------
# Update Alpine security packages
# ------------------------------------------------------------
RUN apk update && \
    apk upgrade --no-cache openssl libcrypto3 libssl3

# ------------------------------------------------------------
# Copy package files
# ------------------------------------------------------------
COPY package*.json ./
COPY next.config.mjs ./
COPY postcss.config.mjs ./
COPY tailwind.config.ts ./
COPY tsconfig.json ./

# ------------------------------------------------------------
# Install dependencies
# ------------------------------------------------------------
RUN npm ci

# ------------------------------------------------------------
# Copy application source
# ------------------------------------------------------------
COPY . .

# ------------------------------------------------------------
# Build application
# ------------------------------------------------------------
RUN npm run build


# ============================================================
# Runtime Stage
# ============================================================
FROM node:24-alpine AS runner

# ------------------------------------------------------------
# Update Alpine security packages
# ------------------------------------------------------------
RUN apk update && \
    apk upgrade --no-cache openssl libcrypto3 libssl3

# ------------------------------------------------------------
# Remove npm from runtime image
#
# The production application runs with:
#     node server.js
#
# npm is only required during the builder stage.
# Removing it prevents npm's own transitive packages
# (tar, brace-expansion, ip-address, etc.) from remaining
# in the production image.
# ------------------------------------------------------------
RUN rm -rf /usr/local/lib/node_modules/npm && \
    rm -f /usr/local/bin/npm /usr/local/bin/npx

# ------------------------------------------------------------
# Non-root User
# ------------------------------------------------------------
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

WORKDIR /app

ENV NODE_ENV=production

# ------------------------------------------------------------
# Copy Next.js standalone production output
# ------------------------------------------------------------
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# ------------------------------------------------------------
# Run as non-root user
# ------------------------------------------------------------
USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
